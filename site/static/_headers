# Cloudflare Pages reads this from the deployed root (build-zola.sh copies
# site/static/ -> public/ via zola, then public/ -> ../public).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Image filenames encode their width and never change contents, so they are safe
# to cache for a year.
/imgs/*
  Cache-Control: public, max-age=31536000, immutable

# main.css is NOT content-hashed — a long max-age here would strand visitors on
# an old stylesheet after a deploy.
/main.css
  Cache-Control: public, max-age=3600

# Rebuilt from the resume repo on every deploy under a stable name.
/AndrewHuntResume.pdf
  Cache-Control: public, max-age=3600
/AndrewHuntResume-ATS.pdf
  Cache-Control: public, max-age=3600
