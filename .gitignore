site/public/

# Cloudflare Pages serves repo-root public/ (generated by build-zola.sh)
/public/

# Generated at build time from the private resume repo (see build-zola.sh).
# No trailing slash: RESUME_DIR makes this a symlink, not a directory.
_resume
site/static/AndrewHuntResume.pdf

# Obsidian per-device state inside the blog vault (site/content/blog/).
# Only .obsidian/app.json and appearance.json are tracked, the settings that
# keep Obsidian writing markdown Zola can render. Everything else is local.
site/content/blog/.obsidian/*
!site/content/blog/.obsidian/app.json
!site/content/blog/.obsidian/appearance.json

# Downloaded Zola binary
site/zola

# Zola's resize_image cache (the srcset widths). Rebuilt by every build, and
# keyed on the source path, not its contents, so a stale copy here would
# outlive an edited image.
site/static/processed_images/

# OS cruft
.DS_Store

# Netlify CLI state
.netlify/

